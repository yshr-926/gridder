# ===========================================
# Gridder 環境変数設定
# ===========================================
# このファイルをコピーして .env を作成してください
# cp .env.example .env
# ===========================================

# アプリケーション設定
# -------------------------------------------
# 環境（development, staging, production）
VITE_APP_ENV=development

# デバッグモード（true/false）
VITE_DEBUG=false

# バージョン情報（ビルド時に自動設定可能）
VITE_APP_VERSION=1.0.0
