# ============================================================
# Gridder - Production Environment Variables
# ============================================================
# Copy this file to .env.prod and update the values
# NEVER commit .env.prod to version control
# ============================================================

# ============================================================
# Domain Configuration
# ============================================================
# Your domain name (e.g., gridder.example.com)
DOMAIN=gridder.example.com

# ============================================================
# Database Configuration (PostgreSQL)
# ============================================================
DB_NAME=gridder
DB_USER=gridder
# IMPORTANT: Use a strong, unique password
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS

# ============================================================
# Redis Configuration
# ============================================================
# IMPORTANT: Use a strong, unique password
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_32_CHARS

# ============================================================
# Authentication
# ============================================================
# JWT signing secret - use a long random string
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_KEY_64_CHARS_MINIMUM

# ============================================================
# TLS/SSL Configuration (Let's Encrypt)
# ============================================================
# Email address for Let's Encrypt certificate notifications
ACME_EMAIL=admin@example.com

# ============================================================
# Traefik Dashboard (Optional)
# ============================================================
# Basic auth for Traefik dashboard
# Generate with: htpasswd -nb admin password
# Note: $ signs must be doubled for docker-compose
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xxxxx$$yyyyy

# ============================================================
# Logging
# ============================================================
# Log level: trace, debug, info, warn, error
RUST_LOG=gridder_backend=info,tower_http=info

# ============================================================
# Security Notes
# ============================================================
# 1. All passwords should be at least 32 characters
# 2. Use different passwords for each service
# 3. Rotate secrets periodically
# 4. Consider using a secrets management tool in production
# 5. Never commit this file with real credentials
