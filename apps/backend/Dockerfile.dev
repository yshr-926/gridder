FROM rust:1.92-slim

WORKDIR /app

# 開発ツールのインストール
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# cargo-watch のインストール
RUN cargo install cargo-watch

# 環境変数
ENV RUST_LOG=debug,gridder_backend=trace
ENV RUST_BACKTRACE=1

EXPOSE 3001

# ホットリロード
CMD ["cargo", "watch", "-x", "run"]
