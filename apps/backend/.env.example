# Server
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/gridder
DATABASE_MAX_CONNECTIONS=20

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Authentication
BCRYPT_ROUNDS=10
MIN_PASSPHRASE_LENGTH=4
MAX_PASSPHRASE_LENGTH=128

# Cleanup
ROOM_EXPIRY_DAYS=7
CLEANUP_INTERVAL_HOURS=24
SNAPSHOT_THRESHOLD=100

# Logging
RUST_LOG=info,gridder_backend=debug,sqlx=warn
RUST_BACKTRACE=1
